MONGODB_URI=mongodb://127.0.0.1:27017/blemout
# Alternative name also supported:
# MONGO_URI=mongodb://127.0.0.1:27017/blemout
JWT_SECRET=your_super_secret_jwt_key_change_this
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PORT=5000
ADMIN_EMAIL=admin@blemout.com
ADMIN_PASSWORD=admin123

# Optional — leave unset until the provider is actually configured.
# STOREFRONT_URL=https://www.blemout.com
